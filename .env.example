# Base URL of the MediFind backend.
#
# Local development: leave this unset. The base URL is then empty, and Vite
# proxies /api, /uploads and /socket.io to http://localhost:3000 (vite.config.js).
#
# Deployed (Vercel): set it to the backend's public origin, with no trailing
# slash. The same value is used for API calls, the Socket.IO connection and the
# uploaded-file URLs, so all three must be reachable from the browser.
#
# VITE_API_URL=https://medifind-api.onrender.com
